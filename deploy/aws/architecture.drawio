<mxfile host="Electron">
  <diagram id="galley-aws" name="サーバーレス案">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="880" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="v1" value="&lt;b&gt;Galley on AWS&lt;/b&gt;　サーバーレス案（#74）" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=18;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="700" height="26" as="geometry"/></mxCell>
        <mxCell id="v2" value="VPC・NAT ゲートウェイ・ロードバランサーを置かず、時間課金のサービスを使わない。使った分だけかかるので、使われない月は保存量の分（と Route 53 のゾーン）だけになる。" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#5A6B86;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1300" height="20" as="geometry"/></mxCell>
        <mxCell id="v3" value="社内のネットワーク・VPN&#xa;（送信元 IP で許可する）" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=4 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;strokeColor=#879196;fontColor=#5A6B86;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="230" height="740" as="geometry"/></mxCell>
        <mxCell id="v4" value="AI エージェント&#xa;（Claude Code など）" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;strokeColor=none;pointerEvents=1;fillColor=#232F3E;shape=mxgraph.aws4.client;" vertex="1" parent="1"><mxGeometry x="111" y="150" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="v5" value="ブラウザー" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;strokeColor=none;pointerEvents=1;fillColor=#232F3E;shape=mxgraph.aws4.users;" vertex="1" parent="1"><mxGeometry x="111" y="420" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="v6" value="AWS Cloud" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;verticalAlign=top;align=left;spacingLeft=30;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="270" y="80" width="1220" height="780" as="geometry"/></mxCell>
        <mxCell id="v7" value="エッジ（グローバル）" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=4 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;strokeColor=#879196;fontColor=#5A6B86;fillColor=none;" vertex="1" parent="1"><mxGeometry x="290" y="120" width="390" height="720" as="geometry"/></mxCell>
        <mxCell id="v8" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;strokeColor=#ffffff;fillColor=#8C4FFF;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudfront;" vertex="1" parent="1"><mxGeometry x="470" y="250" width="56" height="56" as="geometry"/></mxCell>
        <mxCell id="v9" value="&lt;b&gt;CloudFront&lt;/b&gt;（galley.example.com）&#xa;画面・MCP&#xa;・CloudFront Functions で送信元 IP を絞る&#xa;・キャッシュしない（画面のアセットだけ持つ）" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="420" y="168" width="250" height="76" as="geometry"/></mxCell>
        <mxCell id="v10" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;strokeColor=#ffffff;fillColor=#8C4FFF;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudfront;" vertex="1" parent="1"><mxGeometry x="470" y="560" width="56" height="56" as="geometry"/></mxCell>
        <mxCell id="v11" value="&lt;b&gt;CloudFront&lt;/b&gt;（galley-docs.example.com）&#xa;資料配信（アプリと別のオリジン）&#xa;・CloudFront Functions で IP を絞り、&#xa;　/b/&amp;lt;hash&amp;gt; を S3 のキーに書き換える&#xa;・応答ヘッダーポリシーで CSP（sandbox）・&#xa;　nosniff・no-referrer を付ける&#xa;・版は変わらないので長くキャッシュする" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="420" y="624" width="250" height="112" as="geometry"/></mxCell>
        <mxCell id="v12" value="Route 53（任意）&#xa;DNS" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;strokeColor=#ffffff;fillColor=#8C4FFF;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.route_53;" vertex="1" parent="1"><mxGeometry x="340" y="740" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="v13" value="ACM（us-east-1）&#xa;CloudFront の証明書" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;strokeColor=#ffffff;fillColor=#DD344C;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.certificate_manager_3;" vertex="1" parent="1"><mxGeometry x="490" y="740" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="v14" value="東京リージョン（ap-northeast-1）" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;verticalAlign=top;align=left;spacingLeft=30;grIcon=mxgraph.aws4.group_region;strokeColor=#00A4A6;fillColor=none;fontColor=#232F3E;dashed=1;" vertex="1" parent="1"><mxGeometry x="700" y="120" width="770" height="720" as="geometry"/></mxCell>
        <mxCell id="v15" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;strokeColor=#ffffff;fillColor=#E7157B;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;" vertex="1" parent="1"><mxGeometry x="770" y="250" width="56" height="56" as="geometry"/></mxCell>
        <mxCell id="v16" value="&lt;b&gt;API Gateway&lt;/b&gt;（HTTP API）&#xa;カスタムドメイン galley.example.com&#xa;既定のエンドポイントは無効にする" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="730" y="186" width="220" height="58" as="geometry"/></mxCell>
        <mxCell id="v17" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;strokeColor=none;pointerEvents=1;fillColor=#ED7100;shape=mxgraph.aws4.lambda_function;" vertex="1" parent="1"><mxGeometry x="774" y="400" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="v18" value="&lt;b&gt;Lambda オーソライザー&lt;/b&gt;&#xa;CloudFront が付けた秘密のヘッダーを&#xa;確かめる（結果をキャッシュ）" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="730" y="452" width="220" height="48" as="geometry"/></mxCell>
        <mxCell id="v19" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;strokeColor=#ffffff;fillColor=#ED7100;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="1010" y="250" width="56" height="56" as="geometry"/></mxCell>
        <mxCell id="v20" value="&lt;b&gt;Lambda&lt;/b&gt;（arm64）&#xa;Galley ＋ Lambda Web Adapter&#xa;画面と MCP（セッションを持たない）" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="970" y="186" width="220" height="58" as="geometry"/></mxCell>
        <mxCell id="v21" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;strokeColor=#ffffff;fillColor=#C925D1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1"><mxGeometry x="1300" y="250" width="56" height="56" as="geometry"/></mxCell>
        <mxCell id="v22" value="&lt;b&gt;DynamoDB&lt;/b&gt;（オンデマンド）&#xa;プロジェクト・資料・版&#xa;※ 暫定。DB の案の比較は #74" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1250" y="186" width="210" height="58" as="geometry"/></mxCell>

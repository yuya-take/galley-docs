<mxfile host="Electron">
  <diagram id="galley-aws" name="サーバーレス案">
    <mxGraphModel dx="1700" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1610" pageHeight="1010" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="v1" value="&lt;b&gt;Galley on AWS&lt;/b&gt;　サーバーレス案・Cognito でログイン（#74）" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=18;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="900" height="26" as="geometry"/></mxCell>
        <mxCell id="v2" value="VPC・NAT ゲートウェイ・ロードバランサーを置かず、時間課金のサービスを使わない。ログインは Cognito で、画面と資料配信は Lambda@Edge が、MCP は API Gateway の JWT オーソライザーが確かめる。" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#5A6B86;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1500" height="20" as="geometry"/></mxCell>
        <mxCell id="v3" value="利用者（社内・社外）&#xa;IP では絞らない" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=4 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;strokeColor=#879196;fontColor=#5A6B86;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="230" height="870" as="geometry"/></mxCell>
        <mxCell id="v4" value="AI エージェント&#xa;（Claude Code など）" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;strokeColor=none;pointerEvents=1;fillColor=#232F3E;shape=mxgraph.aws4.client;" vertex="1" parent="1"><mxGeometry x="111" y="150" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="v5" value="ブラウザー" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;strokeColor=none;pointerEvents=1;fillColor=#232F3E;shape=mxgraph.aws4.users;" vertex="1" parent="1"><mxGeometry x="111" y="420" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="v6" value="AWS Cloud" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;verticalAlign=top;align=left;spacingLeft=30;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="270" y="80" width="1320" height="910" as="geometry"/></mxCell>
        <mxCell id="v7" value="エッジ（グローバル）" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=4 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;strokeColor=#879196;fontColor=#5A6B86;fillColor=none;" vertex="1" parent="1"><mxGeometry x="290" y="120" width="480" height="850" as="geometry"/></mxCell>
        <mxCell id="v8" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;strokeColor=#ffffff;fillColor=#8C4FFF;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudfront;" vertex="1" parent="1"><mxGeometry x="470" y="250" width="56" height="56" as="geometry"/></mxCell>
        <mxCell id="v9" value="&lt;b&gt;CloudFront&lt;/b&gt;（galley.example.com）&#xa;画面・MCP&#xa;・既定の動作: Lambda@Edge でログインを確かめる&#xa;・/mcp と /.well-known/oauth-protected-resource には&#xa;　関数を付けない（MCP はトークンで守る）&#xa;・キャッシュしない（画面のアセットだけ持つ）" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="420" y="156" width="345" height="88" as="geometry"/></mxCell>
        <mxCell id="v10" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;strokeColor=#ffffff;fillColor=#8C4FFF;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudfront;" vertex="1" parent="1"><mxGeometry x="470" y="620" width="56" height="56" as="geometry"/></mxCell>
        <mxCell id="v11" value="&lt;b&gt;CloudFront&lt;/b&gt;（docs.galley.example.com）&#xa;資料配信（アプリと別のオリジン）&#xa;・同じ Lambda@Edge でログインを確かめる&#xa;・応答ヘッダーポリシーで CSP（sandbox）・nosniff・no-referrer&#xa;・ダウンロードの Content-Disposition は origin-response で付ける&#xa;・版は変わらないので長くキャッシュする" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="420" y="684" width="345" height="96" as="geometry"/></mxCell>
        <mxCell id="v12" value="Route 53（既存のゾーン）&#xa;ID を渡せばレコードを作る" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;strokeColor=#ffffff;fillColor=#8C4FFF;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.route_53;" vertex="1" parent="1"><mxGeometry x="360" y="884" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="v13" value="ACM（us-east-1）&#xa;CloudFront の証明書" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;strokeColor=#ffffff;fillColor=#DD344C;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.certificate_manager_3;" vertex="1" parent="1"><mxGeometry x="580" y="884" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="v14" value="東京リージョン（ap-northeast-1）" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;verticalAlign=top;align=left;spacingLeft=30;grIcon=mxgraph.aws4.group_region;strokeColor=#00A4A6;fillColor=none;fontColor=#232F3E;dashed=1;" vertex="1" parent="1"><mxGeometry x="790" y="120" width="780" height="850" as="geometry"/></mxCell>
        <mxCell id="v15" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;strokeColor=#ffffff;fillColor=#E7157B;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;" vertex="1" parent="1"><mxGeometry x="860" y="250" width="56" height="56" as="geometry"/></mxCell>
        <mxCell id="v16" value="&lt;b&gt;API Gateway&lt;/b&gt;（HTTP API）&#xa;カスタムドメイン galley.example.com&#xa;既定のエンドポイントは無効にする" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="820" y="186" width="220" height="58" as="geometry"/></mxCell>
        <mxCell id="v17" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;strokeColor=none;pointerEvents=1;fillColor=#ED7100;shape=mxgraph.aws4.lambda_function;" vertex="1" parent="1"><mxGeometry x="864" y="360" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="v18" value="&lt;b&gt;Lambda オーソライザー&lt;/b&gt;&#xa;画面のルート（$default）&#xa;CloudFront が付けた秘密の&#xa;ヘッダーを確かめる" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="922" y="356" width="170" height="58" as="geometry"/></mxCell>
        <mxCell id="v19" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;strokeColor=#ffffff;fillColor=#ED7100;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="1100" y="250" width="56" height="56" as="geometry"/></mxCell>
        <mxCell id="v20" value="&lt;b&gt;Lambda&lt;/b&gt;（arm64）&#xa;Galley ＋ Lambda Web Adapter&#xa;画面と MCP（セッションを持たない）" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1060" y="186" width="220" height="58" as="geometry"/></mxCell>
        <mxCell id="v21" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;strokeColor=#ffffff;fillColor=#C925D1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1"><mxGeometry x="1390" y="250" width="56" height="56" as="geometry"/></mxCell>
        <mxCell id="v22" value="&lt;b&gt;DynamoDB&lt;/b&gt;（オンデマンド）&#xa;プロジェクト・資料・版" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1340" y="200" width="210" height="44" as="geometry"/></mxCell>
        <mxCell id="v23" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;strokeColor=#ffffff;fillColor=#7AA116;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1"><mxGeometry x="1390" y="620" width="56" height="56" as="geometry"/></mxCell>
        <mxCell id="v24" value="&lt;b&gt;S3&lt;/b&gt;&#xa;資料の実体&#xa;&amp;lt;prefix&amp;gt;/ab/cd/&amp;lt;hash&amp;gt;.html&#xa;バージョニング" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1350" y="684" width="200" height="64" as="geometry"/></mxCell>
        <mxCell id="v25" value="運用" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#5A6B86;" vertex="1" parent="1"><mxGeometry x="1220" y="852" width="100" height="18" as="geometry"/></mxCell>
        <mxCell id="v26" value="ACM&#xa;API Gateway の証明書" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;strokeColor=#ffffff;fillColor=#DD344C;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.certificate_manager_3;" vertex="1" parent="1"><mxGeometry x="1240" y="878" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="v27" value="ECR&#xa;Lambda のイメージ" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;strokeColor=#ffffff;fillColor=#ED7100;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ecr;" vertex="1" parent="1"><mxGeometry x="1370" y="878" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="v28" value="CloudWatch Logs&#xa;Lambda のログ" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;strokeColor=#ffffff;fillColor=#E7157B;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" vertex="1" parent="1"><mxGeometry x="1490" y="878" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="e29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="v4" target="v8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="400" y="174"/><mxPoint x="400" y="264"/></Array></mxGeometry></mxCell>
        <mxCell id="v30" value="HTTPS /mcp&#xa;Bearer トークン" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#545B64;" vertex="1" parent="1"><mxGeometry x="170" y="140" width="110" height="30" as="geometry"/></mxCell>
        <mxCell id="e31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="v5" target="v8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="370" y="430"/><mxPoint x="370" y="292"/></Array></mxGeometry></mxCell>
        <mxCell id="v32" value="HTTPS&#xa;画面" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#545B64;" vertex="1" parent="1"><mxGeometry x="310" y="350" width="56" height="30" as="geometry"/></mxCell>
        <mxCell id="e33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v5" target="v10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="380" y="444"/><mxPoint x="380" y="648"/></Array></mxGeometry></mxCell>
        <mxCell id="v34" value="iframe（sandbox）&#xa;/b/&amp;lt;hash&amp;gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#545B64;" vertex="1" parent="1"><mxGeometry x="384" y="586" width="106" height="30" as="geometry"/></mxCell>
        <mxCell id="e35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v8" target="v15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="v36" value="Host を転送し、秘密のヘッダーを付ける&#xa;Cookie は galley_author だけを渡す" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#545B64;" vertex="1" parent="1"><mxGeometry x="546" y="284" width="210" height="30" as="geometry"/></mxCell>
        <mxCell id="e37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="v15" target="v17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v15" target="v19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="v39" value="Lambda を呼ぶ&#xa;（6 MB まで）" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#545B64;" vertex="1" parent="1"><mxGeometry x="940" y="284" width="120" height="30" as="geometry"/></mxCell>
        <mxCell id="e40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v19" target="v21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="v41" value="読み書き" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#545B64;" vertex="1" parent="1"><mxGeometry x="1240" y="284" width="100" height="18" as="geometry"/></mxCell>
        <mxCell id="e42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="v19" target="v23"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1128" y="637"/></Array></mxGeometry></mxCell>
        <mxCell id="v43" value="実体を書く・読む" style="text;html=1;align=right;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#545B64;" vertex="1" parent="1"><mxGeometry x="1000" y="560" width="120" height="18" as="geometry"/></mxCell>
        <mxCell id="v44" value="&lt;b&gt;Lambda の主な設定&lt;/b&gt;&#xa;・ALLOWED_HOSTS＝galley.example.com&#xa;・GALLEY_APP_URL・GALLEY_VIEWER_URL&#xa;　（https://docs.galley.example.com）&#xa;・GALLEY_BLOB_STORE＝s3://&amp;lt;バケット&amp;gt;&#xa;・GALLEY_MAX_HTML_SIZE＝4MB&#xa;　（Lambda の 6 MB に収める）&#xa;・MCP_TOKEN は使わない（/mcp は JWT&#xa;　オーソライザーで守る）" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#5A6B86;" vertex="1" parent="1"><mxGeometry x="1160" y="340" width="240" height="130" as="geometry"/></mxCell>
        <mxCell id="e45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="v10" target="v23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="v46" value="OAC（CloudFront だけが読める）" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#545B64;" vertex="1" parent="1"><mxGeometry x="1150" y="664" width="200" height="18" as="geometry"/></mxCell>
        <mxCell id="v47" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;strokeColor=none;pointerEvents=1;fillColor=#ED7100;shape=mxgraph.aws4.lambda_function;" vertex="1" parent="1"><mxGeometry x="474" y="440" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="v48" value="&lt;b&gt;Lambda@Edge&lt;/b&gt;（viewer-request）&#xa;us-east-1 に作り、両方の CloudFront に付ける&#xa;・Cookie の ID トークンを確かめる&#xa;・無ければ Cognito のログインへ回す&#xa;・期限が近ければリフレッシュトークンで更新&#xa;・/_auth/callback でコードをトークンに換え、&#xa;　Cookie（Domain=galley.example.com）を出す&#xa;・資料配信では /b/&amp;lt;hash&amp;gt; を S3 のキーに&#xa;　書き換える" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="532" y="398" width="234" height="124" as="geometry"/></mxCell>
        <mxCell id="v49" value="JWT" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fontColor=#ffffff;fillColor=#E7157B;strokeColor=none;arcSize=12;" vertex="1" parent="1"><mxGeometry x="864" y="470" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="v50" value="&lt;b&gt;JWT オーソライザー&lt;/b&gt;&#xa;MCP のルート（ANY /mcp）&#xa;Cognito のアクセストークン&#xa;（aud が /mcp）を確かめる" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="922" y="466" width="170" height="58" as="geometry"/></mxCell>
        <mxCell id="v51" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;strokeColor=#ffffff;fillColor=#DD344C;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cognito;" vertex="1" parent="1"><mxGeometry x="860" y="800" width="56" height="56" as="geometry"/></mxCell>
        <mxCell id="v52" value="&lt;b&gt;Cognito&lt;/b&gt; ユーザープール（Essentials）&#xa;・マネージドログイン（画面のログイン）&#xa;・動的なクライアント登録（MCP クライアント）&#xa;・自分で登録はさせない" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="926" y="798" width="260" height="58" as="geometry"/></mxCell>

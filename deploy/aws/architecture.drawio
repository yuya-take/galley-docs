        <mxCell id="v26" value="ACM&#xa;API Gateway の証明書" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;strokeColor=#ffffff;fillColor=#DD344C;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.certificate_manager_3;" vertex="1" parent="1"><mxGeometry x="760" y="730" width="40" height="40" as="geometry"/></mxCell>

        <mxCell id="v36" value="Host を転送し、&#xa;秘密のヘッダーを付ける" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#545B64;" vertex="1" parent="1"><mxGeometry x="546" y="284" width="150" height="30" as="geometry"/></mxCell>

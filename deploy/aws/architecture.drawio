        <mxCell id="v43" value="実体を書く・読む" style="text;html=1;align=right;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#545B64;" vertex="1" parent="1"><mxGeometry x="910" y="420" width="120" height="18" as="geometry"/></mxCell>
        <mxCell id="v44" value="&lt;b&gt;Lambda の主な設定&lt;/b&gt;&#xa;・ALLOWED_HOSTS＝galley.example.com&#xa;・GALLEY_APP_URL・GALLEY_VIEWER_URL&#xa;・GALLEY_BLOB_STORE＝s3://&amp;lt;バケット&amp;gt;&#xa;・GALLEY_MAX_HTML_SIZE＝4MB&#xa;　（Lambda の 6 MB に収める）&#xa;・MCP_TOKEN（KMS で暗号化した環境変数）" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#5A6B86;" vertex="1" parent="1"><mxGeometry x="1070" y="340" width="230" height="120" as="geometry"/></mxCell>

        <mxCell id="v46" value="OAC（CloudFront だけが読める）" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#545B64;" vertex="1" parent="1"><mxGeometry x="720" y="602" width="220" height="18" as="geometry"/></mxCell>
